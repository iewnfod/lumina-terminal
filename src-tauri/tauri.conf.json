{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Lumina Terminal",
    "version": "0.2.2",
    "identifier": "com.iewnfod.lumina-terminal",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Lumina Terminal",
                "width": 600,
                "height": 400,
                "minWidth": 600,
                "minHeight": 400,
                "transparent": true,
                "decorations": false,
                "visible": false
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/command-icons/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFM0E3MjQ2ODkxNTJBRUQKUldUdEtoV0pSbkk2WGt2dzRURWZSL2h2eTIxS1c2aDVuR2s2MURVTzU5QzVWUm5hZG9sb2sxelEK",
            "endpoints": [
                "https://github.com/iewnfod/lumina-terminal/releases/latest/download/latest.json"
            ]
        }
    }
}
